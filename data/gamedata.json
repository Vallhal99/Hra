  {
   "id": "hlidka",
   "name": "Hlídač",
   "start": "h1",
   "nodes": [
    {
     "id": "h1",
     "speaker": "Zběhlý hlídač",
     "text": "Pst! Tábor zbojníků je na jihovýchodě. Kdyby je někdo zahnal, kraj by si oddechl.",
     "choices": [
      {
       "text": "Zahnat je? Beru to.",
       "next": "h_ok",
       "cond": {
        "quest_not_started": "tabor"
       }
      },
      {
       "text": "Tábor je hotový.",
       "next": "h_done",
       "cond": {
        "quest_ready": "tabor"
       }
      },
      {
       "text": "Rozloučit se.",
       "next": "h_bye"
      }
     ]
    },
    {
     "id": "h_ok",
     "speaker": "Zběhlý hlídač",
     "text": "Hlídej si záda. Můžeš je překvapit zezadu, nebo jim nastražit past (klávesa T). A slyšel jsem, že v noci kopali na starém hřbitově. Proč, to nevím.",
     "effects": [
      {
       "start_quest": "tabor"
      }
     ]
    },
    {
     "id": "h_done",
     "speaker": "Zběhlý hlídač",
     "text": "Báječně! Jeden z nich, Rys, na tebe už čeká za rohem. Prý ti chce něco říct.",
     "effects": [
      {
       "complete_quest": "tabor"
      },
      {
       "recruit": "rys"
      }
     ],
     "next": "h_rys"
    },
    {
     "id": "h_rys",
     "speaker": "Rys",
     "text": "Takže ty jsi ten, co rozprášil naši partu. Dobře, že to byl někdo, kdo neřeže hned. Poslouchej: byl jsem u toho, když jsme kopali pod mauzoleem. Hledali jsme královský poklad.",
     "next": "h_rys2"
    },
    {
     "id": "h_rys2",
     "speaker": "Rys",
     "text": "Pod deskou byla pečeť. Šéf ji rozbil kladivem. Pak se ozvalo to... chrastění. Utekl jsem první. Teď to musím napravit. Beru tě za slovo, jdu s tebou.",
     "effects": [
      {
       "set_flag": "rys_vina"
      }
     ]
    },
    {
     "id": "h_bye",
     "speaker": "Zběhlý hlídač",
     "text": "Opatrně, cizinče."
    }
   ]
  },
  {
   "id": "knez",
   "name": "Farář – rozhovor",
   "start": "f1",
   "nodes": [
    {
     "id": "f1",
     "speaker": "Farář Alois",
     "text": "Pokoj s tebou, poutníku. Ale ne s tímhle místem... Hřbitov už není, co býval.",
     "choices": [
      {
       "text": "Co se tu děje?",
       "next": "f_n",
       "cond": {
        "quest_not_started": "neklid"
       }
      },
      {
       "text": "Přízraky jsou pryč.",
       "next": "f_n_done",
       "cond": {
        "quest_ready": "neklid"
       }
      },
      {
       "text": "Kde je ten přízrak, o kterém mluvíš?",
       "next": "f_n_where",
       "cond": {
        "quest_active": "neklid"
       }
      },
      {
       "text": "Brum už pečeť obnovil.",
       "next": "f_seal",
       "cond": {
        "quest_done": "zapecetit",
        "quest_not_started": "kral"
       }
      },
      {
       "text": "Co mám dělat dál?",
       "next": "f_next",
       "cond": {
        "quest_done": "neklid",
        "quest_not_started": "zapecetit"
       }
      },
      {
       "text": "Kde je ta Hrobka?",
       "next": "f_where",
       "cond": {
        "quest_active": "kral"
       }
      },
      {
       "text": "Kostěný král je poražen.",
       "next": "f_end",
       "cond": {
        "quest_ready": "kral"
       }
      },
      {
       "text": "Jak se ti daří, otče?",
       "next": "f_after",
       "cond": {
        "quest_done": "kral"
       }
      },
      {
       "text": "Nashledanou.",
       "next": "f_bye"
      }
     ]
    },
    {
     "id": "f_n",
     "speaker": "Farář Alois",
     "text": "Před sto lety tu byl pohřben král Gorvan, krutý panovník. Mniši ho zapečetili pod mauzoleem. Teď se ze země zjevují přízraky. Poraz dva z nich, ať vidím, jak silně je pečeť poškozená. Jsou slabí proti světlu a ohni.",
     "choices": [
      {
       "text": "Postarám se o to.",
       "next": "f_n_ok",
       "effects": [
        {
         "start_quest": "neklid"
        }
       ]
      },
      {
       "text": "Nejdřív se připravím.",
       "next": "f1"
      }
     ]
    },
    {
     "id": "f_n_ok",
     "speaker": "Farář Alois",
     "text": "Ať tě světlo provází."
    },
    {
     "id": "f_n_where",
     "speaker": "Farář Alois",
     "text": "Potulují se po hřbitově. Hledej jejich modrou záři."
    },
    {
     "id": "f_n_done",
     "speaker": "Farář Alois",
     "text": "Dobrá práce. Pečeť je tedy opravdu rozbitá, jak jsem se bál. Tady je klíč od mauzolea. Čtyřicet let jsem ho nosil na krku a doufal, že ho nikdy nebudu potřebovat.",
     "effects": [
      {
       "complete_quest": "neklid"
      }
     ],
     "next": "f_next"
    },
    {
     "id": "f_next",
     "speaker": "Farář Alois",
     "text": "Pečeť před dvaceti lety opravoval kovář Brum. Jen on ví, jak ji znovu ukovat. Zajdi za ním do vesnice. Řekni mu, že tě posílám já."
    },
    {
     "id": "f_seal",
     "speaker": "Farář Alois",
     "text": "Díky Bohu. Pečeť drží, ale král už je vzhůru a uvnitř jeho kostlivců přibývá. Musíš sestoupit do Hrobky a skoncovat s ním. Dveře jsou v mauzoleu na severu hřbitova.",
     "choices": [
      {
       "text": "Jdu na to.",
       "next": "f_ok",
       "effects": [
        {
         "start_quest": "kral"
        }
       ]
      },
      {
       "text": "Ještě se připravím.",
       "next": "f1"
      }
     ]
    },
    {
     "id": "f_ok",
     "speaker": "Farář Alois",
     "text": "Vezmi si lektvary a nech si u kováře vylepšit zbraň. Kostěný král je slabý proti světlu, ohni a sekeře. Ať tě světlo provází."
    },
    {
     "id": "f_where",
     "speaker": "Farář Alois",
     "text": "Mauzoleum na severu hřbitova. Uvnitř jdi stále na sever, král sedí na pódiu."
    },
    {
     "id": "f_end",
     "speaker": "Farář Alois",
     "text": "Takže je po všem? Slyšel jsem, jak se zem otřásla... Děkuji ti, hrdino. Všechny mrtvé jsi vrátil k odpočinku. Co teď uděláš?",
     "choices": [
      {
       "text": "Zůstanu tady. Tohle místo je teď můj domov.",
       "next": "f_stay"
      },
      {
       "text": "Půjdu dál. Cesta na mě ještě čeká.",
       "next": "f_go"
      }
     ]
    },
    {
     "id": "f_stay",
     "speaker": "Farář Alois",
     "text": "Vesnice ti otevře dveře i srdce. Tohle je odměna od všech vesničanů.",
     "effects": [
      {
       "complete_quest": "kral"
      },
      {
       "set_flag": "konec_zustat"
      },
      {
       "ending": "zustat"
      }
     ]
    },
    {
     "id": "f_go",
     "speaker": "Farář Alois",
     "text": "Cesta tě volá a ty ji nikdy nezradíš. Tohle je odměna od všech vesničanů. Vždy se můžeš vrátit.",
     "effects": [
      {
       "complete_quest": "kral"
      },
      {
       "set_flag": "konec_putovat"
      },
      {
       "ending": "putovat"
      }
     ]
    },
    {
     "id": "f_after",
     "speaker": "Farář Alois",
     "text": "Hřbitov je klidný jako nikdy. Děkuji ti."
    },
    {
     "id": "f_bye",
     "speaker": "Farář Alois",
     "text": "Pokoj s tebou."
    }
   ]
  },
  {
   "id": "kovar",
   "name": "Kovář – rozhovor",
   "start": "k1",
   "nodes": [
    {
     "id": "k1",
     "speaker": "Kovář Brum",
     "text": "Hmpf. Potřebuješ pořádnou ocel, nebo jen okukuješ moje kovadlinu?",
     "choices": [
      {
       "text": "Ukaž mi zbraně a zbroj.",
       "next": "k_shop"
      },
      {
       "text": "Potřebuji opravit výbavu nebo vylepšit zbraň.",
       "next": "k_rep"
      },
      {
       "text": "Farář Alois mě posílá kvůli pečeti.",
       "next": "k_p1",
       "cond": {
        "quest_done": "neklid",
        "quest_not_started": "zapecetit"
       }
      },
      {
       "text": "Mám rudu a kostní prach.",
       "next": "k_p2",
       "cond": {
        "quest_ready": "zapecetit"
       }
      },
      {
       "text": "Co ta pečeť? Potřebuješ ještě něco?",
       "next": "k_p1w",
       "cond": {
        "quest_active": "zapecetit"
       }
      },
      {
       "text": "Jen jdu okolo.",
       "next": "k_bye"
      }
     ]
    },
    {
     "id": "k_rep",
     "speaker": "Kovář Brum",
     "text": "Dej to sem. Spočítám ti to podle škod.",
     "effects": [
      {
       "shop": "kovar"
      }
     ],
     "next": "k1"
    },
    {
     "id": "k_shop",
     "speaker": "Kovář Brum",
     "text": "Tohle je poctivá práce. Vyber si.",
     "effects": [
      {
       "shop": "kovar"
      }
     ],
     "next": "k1"
    },
    {
     "id": "k_p1",
     "speaker": "Kovář Brum",
     "text": "Hmpf. Takže se to stalo. Před dvaceti lety jsem ji kul já, s mnichy. Pečeť z oceli, zalitá kostním prachem. Pamatuju si ji do poslední rýhy.",
     "next": "k_p1b"
    },
    {
     "id": "k_p1b",
     "speaker": "Kovář Brum",
     "text": "Potřebuju tři kusy železné rudy a dvě hrsti kostního prachu. Ruda i prach padají z kostlivců a zbojníků. Obchoduju s nimi taky, ale bez prachu to nepůjde. Přines mi to.",
     "choices": [
      {
       "text": "Mám to u sebe. Hned se vrátím.",
       "next": "k_p1c",
       "effects": [
        {
         "start_quest": "zapecetit"
        }
       ]
      },
      {
       "text": "Vrátím se.",
       "next": "k1"
      }
     ]
    },
    {
     "id": "k_p1c",
     "speaker": "Kovář Brum",
     "text": "Hmpf. Dobře."
    },
    {
     "id": "k_p1w",
     "speaker": "Kovář Brum",
     "text": "Tři kusy rudy, dvě hrsti prachu. Jinak ti nic neukovám."
    },
    {
     "id": "k_p2",
     "speaker": "Kovář Brum",
     "text": "Hmpf. To stačí. Kladivo sem. ...Hotovo. Pečeť je zpátky na místě. Tady, z odřezků jsem ti ukul hrot kopí. Mrtví před ním ustupují. A ještě něco: půjdu s tebou. Je to moje pečeť, moje práce.",
     "effects": [
      {
       "complete_quest": "zapecetit"
      },
      {
       "recruit": "brum"
      },
      {
       "set_flag": "seal_done"
      }
     ]
    },
    {
     "id": "k_bye",
     "speaker": "Kovář Brum",
     "text": "Tak ať ti meč slouží."
    }
   ]
  },
  {
   "id": "hostinsky",
   "name": "Hostinský – rozhovor",
   "start": "h1",
   "nodes": [
    {
     "id": "h1",
     "speaker": "Hostinský Bohouš",
     "text": "Vítej v hostinci U Zlatého sudu! Postel za 20 zlatých a ráno ti dám i snídani.",
     "choices": [
      {
       "text": "Přenocovat (20 zl., uložit hru).",
       "next": "h_rest",
       "cond": {
        "gold_min": 20
       }
      },
      {
       "text": "Co je nového?",
       "next": "h_news"
      },
      {
       "text": "Povídej o vsi.",
       "next": "h_lore"
      },
      {
       "text": "Jen se dívám.",
       "next": "h_bye"
      }
     ]
    },
    {
     "id": "h_rest",
     "speaker": "Hostinský Bohouš",
     "text": "Zzzz... Dobré ráno! Hra byla uložena do slotu 1. Máš naspáno?",
     "effects": [
      {
       "rest": 20
      }
     ]
    },
    {
     "id": "h_news",
     "speaker": "Hostinský Bohouš",
     "text": "Povídá se, že na hřbitově straší a v Hvozdu řádí zbojníci. Farář Alois je z toho celý bez sebe, nikdy ho neviděl nespat. A kovář prý umí vylepšit i obyčejný meč."
    },
    {
     "id": "h_lore",
     "speaker": "Hostinský Bohouš",
     "text": "Vesnici založil můj pradědeček, když jsme tu našli pramen a zlatý sud pod kořeny dubu. Dub už je dávno pryč, hospoda zůstala. Lidé se k nám vždycky vrátí. I ti, co odešli."
    },
    {
     "id": "h_bye",
     "speaker": "Hostinský Bohouš",
     "text": "Kdyby něco, jen zavolej."
    }
   ]
  },
  {
   "id": "elis",
   "name": "Elis – setkání",
   "start": "e1",
   "nodes": [
    {
     "id": "e1",
     "speaker": "Elis",
     "text": "Stůj. Vidím, že nemíříš na trh, ale tam, kam nikdo rozumný nechodí. Do Hrobky pod mauzoleem, že?",
     "choices": [
      {
       "text": "Víš o ní něco?",
       "next": "e2"
      },
      {
       "text": "Pojď se mnou. Hodí se mi mág.",
       "next": "e_join"
      },
      {
       "text": "Jen jdu okolo.",
       "next": "e_bye"
      }
     ]
    },
    {
     "id": "e2",
     "speaker": "Elis",
     "text": "Jsem učednice mágů z věže na severu. Vyhnali mě za příliš zvědavé otázky. Pečeť pod mauzoleem prý drží něco, co se nemá probouzet. A já chci vědět co.",
     "choices": [
      {
       "text": "Tak pojď. Dvě hlavy a jedna hůl jsou víc než jedna.",
       "next": "e_join"
      },
      {
       "text": "Zatím ne.",
       "next": "e_bye"
      }
     ]
    },
    {
     "id": "e_join",
     "speaker": "Elis",
     "text": "Dobře. Ale ber to tak: když něco shoříme, byl to tvůj nápad. Jdu s tebou.",
     "effects": [
      {
       "recruit": "elis"
      }
     ]
    },
    {
     "id": "e_bye",
     "speaker": "Elis",
     "text": "Budu tady. Zvědavost nikam neutíká."
    }
   ]
  }
